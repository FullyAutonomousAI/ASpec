diff --git a/python/sglang/srt/models/dflash.py b/python/sglang/srt/models/dflash.py
--- a/python/sglang/srt/models/dflash.py
+++ b/python/sglang/srt/models/dflash.py
@@ -459,6 +459,39 @@ class DFlashMLP(nn.Module):
         x = self.act_fn(gate_up)
         x, _ = self.down_proj(x)
         return x
+
+
+def _build_dflash_mlp(
+    config, layer_id: int, quant_config=None, prefix: str = ""
+) -> nn.Module:
+    """Build only explicitly declared Draft FFN structures."""
+    ffn_type = getattr(config, "ffn_type", "dense")
+    if ffn_type == "dense":
+        return DFlashMLP(config=config, quant_config=quant_config, prefix=prefix)
+    if int(get_parallel().moe_ep_size) != 1:
+        raise ValueError(
+            "DFlash MoE serving has not validated expert parallelism; "
+            "use moe_ep_size=1."
+        )
+    if ffn_type == "qwen3_moe":
+        from sglang.srt.models.qwen3_moe import Qwen3MoeSparseMoeBlock
+
+        return Qwen3MoeSparseMoeBlock(
+            layer_id=layer_id,
+            config=config,
+            quant_config=quant_config,
+            prefix=prefix,
+        )
+    if ffn_type == "ling_moe":
+        from sglang.srt.models.bailing_moe_v3 import BailingMoE
+
+        return BailingMoE(
+            config=config,
+            quant_config=quant_config,
+            layer_id=layer_id,
+            prefix=prefix,
